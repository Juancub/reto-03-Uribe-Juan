# Puerto del servidor backend
PORT=3000

# Proveedor de LLM (gemini | openai)
LLM_PROVIDER=gemini

# Claves de API (Configura la correspondiente al proveedor elegido)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Modelo a utilizar
# Para Gemini: gemini-1.5-flash o gemini-2.5-flash
# Para OpenAI: gpt-4o-mini o gpt-4o
LLM_MODEL=gemini-1.5-flash

# Configuración de límites y robustez
MAX_ITERATIONS=25
MAX_SESSION_TOKENS=50000

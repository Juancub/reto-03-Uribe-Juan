{
  "name": "reto-03-agente-ordenes-compra-sap",
  "version": "1.0.0",
  "description": "Agente conversacional completo para automatizar órdenes de compra en SAP - Reto 03 Periferia IT Group",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "npm run --prefix web dev",
    "demo": "tsx demo.ts",
    "build:client": "npm run --prefix web build",
    "build": "npm run build:client && tsc --noEmit",
    "start": "tsx src/server.ts"
  },
  "keywords": [
    "sap",
    "ai-agent",
    "purchase-orders",
    "react",
    "typescript",
    "gemini"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "openai": "^4.68.2",
    "pdf-lib": "^1.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
